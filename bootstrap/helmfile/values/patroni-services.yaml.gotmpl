# Chart tests restart Patroni, so they are disabled.
postgresPassword: password

backupDaemon:
  install: false

dbaas:
  install: true
  aggregator:
    registrationAddress: {{ printf "http://%s.%s.svc.cluster.local:8080" (env "DBAAS_SERVICE_NAME" | default "dbaas-aggregator") (env "DBAAS_NAMESPACE" | default "dbaas") | quote }}
    registrationUsername: cluster-dba
    registrationPassword: password

tests:
  install: false
