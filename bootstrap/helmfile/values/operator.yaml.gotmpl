TAG: {{ requiredEnv "OPERATOR_TAG" | quote }}

NAMESPACE: {{ env "DBAAS_NAMESPACE" | default "dbaas" | quote }}

MONITORING_ENABLED: false
DBAAS_OPERATOR_ENABLED: {{ env "DBAAS_OPERATOR_ENABLED" | default "true" }}
{{- with env "M2M_AUTH_MODE" }}
M2M_AUTH_MODE: {{ . | quote }}
KUBERNETES_M2M_ENABLED: {{ ne . "legacy" }}
{{- end }}
