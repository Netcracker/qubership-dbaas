DECLARATIVE_HOOK_IMAGE: {{ printf "ghcr.io/netcracker/qubership-dbaas-validation-image:%s" (requiredEnv "AGGREGATOR_TAG") | quote }}
IMAGE_REPOSITORY: ghcr.io/netcracker/qubership-dbaas
TAG: {{ requiredEnv "AGGREGATOR_TAG" | quote }}

APPLICATION_NAME: dbaas
SERVICE_NAME: {{ env "DBAAS_SERVICE_NAME" | default "dbaas-aggregator" | quote }}
CLOUD_TOPOLOGY_KEY: kubernetes.io/hostname
READONLY_CONTAINER_FILE_SYSTEM_ENABLED: false
REPLICA_ROLLING_TIMEOUT_SECONDS: 600
LIVENESS_PROBE_INITIAL_DELAY_SECONDS: 120
REGION_DBAAS: {{ requiredEnv "REGION_DBAAS" | quote }}
NODE_SELECTOR_DBAAS_KEY: {{ requiredEnv "NODE_SELECTOR_DBAAS_KEY" | quote }}
DBAAS_RECREATE_DEPLOYMENT_STRATEGY: false

LOG_LEVEL: "INFO"
DBAAS_LOG_LEVEL: "INFO"

DISABLE_DEPRECATED_API: false

PRODUCTION_MODE: true
POSTGRES_HOST: {{ printf "pg-patroni.%s" (env "PG_NAMESPACE" | default "postgres") | quote }}
POSTGRES_PORT: "5432"
DBAAS_SECURITY_CONFIGURATION_LOCATION: "/etc/dbaas/security"
DBAAS_GLOBAL_PERMISSIONS_CONFIGURATION_LOCATION: "/etc/dbaas/global_permissions"
DBAAS_PREMATURE_REGISTRATION_ADAPTER_ADDRESSES: ""
DBAAS_DEFAULT_PHYSICAL_DATABASES_DISABLED: false

DBAAS_SECURITY_NAMESPACE_ISOLATION_ENABLED: true
KUBERNETES_M2M_ENABLED: true

MEM_ARGS: "-Xms128m -Xmx128m -Xss512k -XX:MetaspaceSize=136m -XX:MaxMetaspaceSize=136m -XX:ReservedCodeCacheSize=64M -XX:CompressedClassSpaceSize=32M -XX:MinMetaspaceExpansion=1M -XX:MaxMetaspaceExpansion=8M -XX:CodeCacheExpansionSize=256k -XX:MaxDirectMemorySize=10m -XX:+UseParallelGC -XX:MinHeapFreeRatio=20 -XX:MaxHeapFreeRatio=40 -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90"
MEMORY_LIMIT: "520Mi"
CPU_LIMIT: "2"
CPU_REQUEST: "100m"
REPLICAS: {{ env "AGGREGATOR_REPLICAS" | default "1" }}

BACKUP_DAEMON_DBAAS_ACCESS_PASSWORD: {{ requiredEnv "BACKUP_DAEMON_DBAAS_ACCESS_PASSWORD" | quote }}
DBAAS_CLUSTER_DBA_CREDENTIALS_PASSWORD: {{ requiredEnv "DBAAS_CLUSTER_DBA_CREDENTIALS_PASSWORD" | quote }}
DBAAS_TENANT_PASSWORD: {{ requiredEnv "DBAAS_TENANT_PASSWORD" | quote }}
DBAAS_DB_EDITOR_CREDENTIALS_PASSWORD: {{ requiredEnv "DBAAS_DB_EDITOR_CREDENTIALS_PASSWORD" | quote }}
DISCR_TOOL_USER_PASSWORD: {{ requiredEnv "DISCR_TOOL_USER_PASSWORD" | quote }}
POSTGRES_DBAAS_USER: postgres
POSTGRES_DBAAS_PASSWORD: {{ requiredEnv "POSTGRES_PASSWORD" | quote }}
POSTGRES_DBAAS_DATABASE_NAME: dbaas
DBAAS_BACKUP_RESTORE_CHECK_ATTEMPTS: 20
DBAAS_BACKUP_RESTORE_RETRY_DELAY_SECONDS: 3
DBAAS_BACKUP_RESTORE_RETRY_ATTEMPTS: 3
DBAAS_BACKUP_RESTORE_CHECK_INTERVAL: "1m"
DBAAS_BACKUP_RESTORE_CHECK_LOCK_TIMEOUT: "PT10M"
