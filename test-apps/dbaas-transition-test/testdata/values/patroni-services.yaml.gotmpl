# Disable fixture integration tests because they restart Patroni during availability checks.
postgresPassword: {{ requiredEnv "POSTGRES_PASSWORD" | quote }}

backupDaemon:
  install: false
  storage:
    storageClass: standard
    type: pv
    size: 2Gi

dbaas:
  install: true
  aggregator:
    registrationAddress: {{ printf "http://%s.%s.svc.cluster.local:8080" (requiredEnv "DBAAS_SERVICE_NAME") (requiredEnv "DBAAS_NAMESPACE") | quote }}
    registrationUsername: cluster-dba
    registrationPassword: {{ requiredEnv "DBAAS_CLUSTER_DBA_CREDENTIALS_PASSWORD" | quote }}

tests:
  install: false
