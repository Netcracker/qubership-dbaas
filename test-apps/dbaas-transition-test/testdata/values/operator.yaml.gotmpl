# dbaas-operator values for the transition test. Always installed from the fixture checkout at
# FIXTURE_TAG — the newer of the two aggregator versions under test, held fixed for both directions
# (see helmfile.yaml.gotmpl's header comment) — so neither direction needs operator-version-specific
# setup.
NODE_SELECTOR_DBAAS_KEY: {{ requiredEnv "NODE_SELECTOR_DBAAS_KEY" | quote }}
REGION_DBAAS: {{ requiredEnv "REGION_DBAAS" | quote }}

IMAGE_REPOSITORY: ghcr.io/netcracker/qubership-dbaas-operator
TAG: {{ requiredEnv "FIXTURE_TAG" | quote }}

NAMESPACE: {{ requiredEnv "DBAAS_NAMESPACE" | quote }}

restrictedEnvironment: false

MONITORING_ENABLED: false
DBAAS_OPERATOR_ENABLED: true
PAAS_PLATFORM: KUBERNETES

LOG_LEVEL: "info"
K8S_EVENTS_ENABLED: true
LEADER_ELECT: true
# Poll the aggregator's changed-databases feed frequently so password rotations propagate within
# seconds. This test doesn't depend on rotation speed; the setting is inherited unchanged from
# bootstrap/dbaas-operator-values.yaml, which this file replaces.
DBAAS_ROTATION_POLL_INTERVAL: "2s"
DBAAS_EXTERNAL_DATABASE_RESYNC_INTERVAL: "30s"

# Operator authenticates to the aggregator via M2M (projected ServiceAccount token), matching the
# aggregator's own KUBERNETES_M2M_ENABLED=true in dbaas.yaml.gotmpl.
KUBERNETES_M2M_ENABLED: true
